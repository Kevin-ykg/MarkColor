<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="MarkColorDemo.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:local="clr-namespace:MarkColorDemo"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="设置与标准微调"
  Icon="Assets/CmykMark.ico"
  Width="1140"
  Height="790"
  MinWidth="1000"
  MinHeight="640"
  WindowStartupLocation="CenterOwner">
  <Grid
    Margin="20"
    Background="#F3F5F8">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel
      Margin="0,0,0,14">
      <TextBlock
        x:Name="SettingsTitle"
        Text="检测设置与标准微调"
        FontSize="23"
        FontWeight="SemiBold"
        Foreground="#183C53" />
      <TextBlock
        x:Name="SettingsDescription"
        Text="提取参数改变时重建全部标准采样，保留人工 Lab 偏移；修改前可预览，应用后请保存标准。"
        Foreground="#657A8E"
        Margin="0,8,0,0" />
    </StackPanel>
    <TabControl
      x:Name="SettingsTabs"
      Grid.Row="1"
      Background="White"
      BorderBrush="#D5DFE8">
      <TabItem
        Header="常用设置">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Button
              Content="扩展圆点尺寸：8–500 px"
              Click="WideRadius_Click"
              HorizontalAlignment="Left"
              Margin="20,12,20,0" />
            <Grid
              x:Name="ParameterGrid"
              Margin="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="220" />
                <ColumnDefinition
                  Width="120" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem
        Header="定位高级参数">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto">
          <Grid
            x:Name="AdvancedGrid"
            Margin="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="240" />
              <ColumnDefinition
                Width="120" />
              <ColumnDefinition
                Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem
        Header="测量质量">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto">
          <Grid
            x:Name="QualityGrid"
            Margin="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="240" />
              <ColumnDefinition
                Width="120" />
              <ColumnDefinition
                Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem
        x:Name="RoiTab"
        Header="ROI / 预览">
        <DockPanel
          Margin="12">
          <StackPanel
            DockPanel.Dock="Top">
            <TextBlock
              Text="左侧拖框设置 ROI；右侧为草稿参数预览，所有取色使用原图。"
              Margin="0,0,0,8" />
            <Button
              Content="预览当前参数（不应用）"
              Click="Preview_Click"
              HorizontalAlignment="Left" />
          </StackPanel>
          <ScrollViewer
            DockPanel.Dock="Bottom"
            MaxHeight="130">
            <TextBlock
              x:Name="PreviewInfo"
              TextWrapping="Wrap"
              Margin="0,8" />
          </ScrollViewer>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition
                Width="10" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!-- ROI 从原始图像视图框选，输出归一化坐标；预览不提交正式检测参数。 -->
            <local:ImageViewport
              x:Name="BeforeView" />
            <local:ImageViewport
              x:Name="AfterView"
              Grid.Column="2" />
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem
        x:Name="StandardsTab"
        Header="逐点标准 / 墨路 / 阈值">
        <DockPanel
          Margin="14">
          <TextBlock
            DockPanel.Dock="Top"
            TextWrapping="Wrap"
            Foreground="#5B7185"
            Margin="0,0,0,12"
            Text="名称和墨路仅作标注，不参与匹配。请根据打印配方确认墨路；蓝、绿、红通常需结合配方分析。可微调标准 L*a*b*；|ΔL|、|Δa|、|Δb| 阈值为 0 时关闭该项。" />
          <StackPanel
            DockPanel.Dock="Bottom"
            Orientation="Horizontal"
            Margin="0,12,0,0">
            <Button
              Content="恢复采样均值"
              Click="RestoreLab_Click" />
            <TextBlock
              Text="将统一 ΔE00 阈值应用到全部圆点："
              VerticalAlignment="Center" />
            <TextBox
              x:Name="GlobalThreshold"
              Width="80"
              Text="3" />
            <Button
              Content="应用到表格"
              Click="ApplyThreshold_Click"
              Margin="10,0,0,0" />
          </StackPanel>
          <!-- 编辑的是标准草稿；后台重建与最终提交由主窗口设置流程负责。 -->
          <DataGrid
            x:Name="StandardsGrid">
            <DataGrid.Columns>
              <DataGridTextColumn
                Header="#"
                Binding="{Binding Id}"
                IsReadOnly="True"
                Width="35" />
              <DataGridTextColumn
                Header="Mark 名称"
                Binding="{Binding Name}"
                Width="100" />
              <DataGridTextColumn
                Header="对应墨路"
                Binding="{Binding InkChannel}"
                Width="170" />
              <DataGridTextColumn
                Header="原始采样 Lab"
                Binding="{Binding RawLab}"
                IsReadOnly="True"
                Width="165" />
              <DataGridTextColumn
                Header="拍摄间 σL/σa/σb"
                Binding="{Binding RepeatabilityText}"
                IsReadOnly="True"
                Width="160" />
              <DataGridTextColumn
                Header="标准 L*"
                Binding="{Binding L, StringFormat=F3, ValidatesOnExceptions=True}"
                Width="90" />
              <DataGridTextColumn
                Header="标准 a*"
                Binding="{Binding A, StringFormat=F3, ValidatesOnExceptions=True}"
                Width="90" />
              <DataGridTextColumn
                Header="标准 b*"
                Binding="{Binding B, StringFormat=F3, ValidatesOnExceptions=True}"
                Width="90" />
              <DataGridTextColumn
                Header="ΔE00 阈值"
                Binding="{Binding DeltaEThreshold, ValidatesOnExceptions=True}"
                Width="100" />
              <DataGridTextColumn
                Header="|ΔL| 阈值"
                Binding="{Binding MaxDeltaL, ValidatesOnExceptions=True}"
                Width="95" />
              <DataGridTextColumn
                Header="|Δa| 阈值"
                Binding="{Binding MaxDeltaA, ValidatesOnExceptions=True}"
                Width="95" />
              <DataGridTextColumn
                Header="|Δb| 阈值"
                Binding="{Binding MaxDeltaB, ValidatesOnExceptions=True}"
                Width="95" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem
        x:Name="ColorDifferenceTab"
        Header="ΔE00 参数">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto">
          <StackPanel
            Margin="20">
            <TextBlock
              Text="色差参数因子"
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="#183C53" />
            <TextBlock
              Text="所有圆点共用当前标准的参数；只改变色差比较，不改变 Lab、轮廓或几何匹配。"
              TextWrapping="Wrap"
              Margin="0,10,0,18"
              Foreground="#50667C" />
            <Grid
              x:Name="ColorDifferenceGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="220" />
                <ColumnDefinition
                  Width="120" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
            </Grid>
            <Button
              Content="恢复 kL / kC / kH = 1"
              Click="ResetColor_Click"
              HorizontalAlignment="Left"
              Margin="0,18,0,12" />
            <Border
              Background="#FFF5DF"
              Padding="16"
              CornerRadius="6">
              <TextBlock
                Text="因子越大，对该分量越不敏感。增大 kL 可以减弱亮度波动，但也可能降低对真实缺墨的敏感度。请用 OK / NG 样本重新验证阈值。这里的参数不是 L、a、b 的百分比；逐点 |ΔL| 等限值仍独立生效。"
                TextWrapping="Wrap"
                Foreground="#73591C" />
            </Border>
            <TextBlock
              Text="应用后立即重新比较；点击“保存标准”后，参数会随标准文件保存。旧版标准缺少这些参数时，默认按 1 / 1 / 1 读取。"
              TextWrapping="Wrap"
              Foreground="#50667C"
              Margin="0,18,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel
      Grid.Row="2">
      <TextBlock
        x:Name="ChangeReasonLabel"
        Text="人工修改目标 Lab 时填写原因（随标准版本保存）"
        Margin="0,8,0,4" />
      <TextBox
        x:Name="ChangeNote"
        MaxLength="300" />
      <TextBlock
        x:Name="ErrorText"
        Grid.Row="2"
        Foreground="#BB3045"
        TextWrapping="Wrap"
        Margin="0,10,0,10" />
    </StackPanel>
    <StackPanel
      Grid.Row="3"
      Orientation="Horizontal"
      HorizontalAlignment="Right">
      <Button
        Content="恢复默认参数"
        Click="Reset_Click" />
      <Button
        Content="取消"
        IsCancel="True" />
      <Button
        x:Name="ApplySettingsButton"
        Content="应用设置并重新检测"
        IsDefault="True"
        Click="Apply_Click"
        Background="#087F8C"
        Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
