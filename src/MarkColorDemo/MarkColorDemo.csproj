<Project
  Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Platform
      Condition="'$(Platform)' == ''">x64</Platform>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AssemblyName>MarkColorDemo</AssemblyName>
    <ApplicationIcon>Assets\CmykMark.ico</ApplicationIcon>
    <!-- F5 启用托管/本机混合调试；交给 MSBuild 检查 Native 依赖是否需要重新生成。 -->
    <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <Import
    Project="../../build-support/OpenCV.props" />
  <ItemGroup>
    <Resource
      Include="Assets\CmykMark.ico" />
    <!-- C++ DLL 是构建依赖而非托管程序集；P/Invoke 加载由 Native.Runtime.targets 复制的 DLL。 -->
    <ProjectReference
      Include="../../native/MarkColorNative.vcxproj"
      ReferenceOutputAssembly="false"
      SkipGetTargetFrameworkProperties="true"
      Private="false">
      <Project>{D699B057-3B31-4918-BD59-9B977A6BE5B1}</Project>
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>
  <Import
    Project="../../build-support/Native.Runtime.targets" />
</Project>
