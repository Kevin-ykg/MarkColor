<Window
  x:Class="MarkColorDemo.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:MarkColorDemo"
  Title="Mark 色彩检测"
  Icon="Assets/CmykMark.ico"
  Width="1440"
  Height="960"
  MinWidth="1140"
  MinHeight="760"
  WindowStartupLocation="CenterScreen"
  AllowDrop="True"
  Drop="OnDrop">
  <Window.Resources>
    <Style
      x:Key="ActionButton"
      TargetType="Button"
      BasedOn="{StaticResource {x:Type Button}}">
      <Setter
        Property="FontSize"
        Value="16" />
      <Setter
        Property="FontWeight"
        Value="SemiBold" />
      <Setter
        Property="MinHeight"
        Value="44" />
      <Setter
        Property="Padding"
        Value="18,9" />
      <Setter
        Property="Margin"
        Value="0,0,10,8" />
    </Style>
    <Style
      TargetType="ContextMenu">
      <Setter
        Property="FontSize"
        Value="15" />
      <Setter
        Property="Padding"
        Value="6" />
    </Style>
    <Style
      TargetType="MenuItem">
      <Setter
        Property="Padding"
        Value="12,9" />
    </Style>
  </Window.Resources>
  <Grid
    Background="#F3F5F8">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="64" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="280" />
      <RowDefinition
        Height="34" />
    </Grid.RowDefinitions>
    <Border
      Background="#152C40"
      Padding="22,10"
      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <DockPanel>
        <TextBlock
          DockPanel.Dock="Right"
          Text="CMYK / 颜色一致性"
          FontSize="14"
          Foreground="#AEC6D8"
          VerticalAlignment="Center" />
        <Image
          Source="{StaticResource CmykAppMark}"
          Width="42"
          Height="42"
          Margin="0,0,14,0"
          DockPanel.Dock="Left" />
        <TextBlock
          Text="MARK  /  色彩检测"
          FontSize="23"
          FontWeight="SemiBold"
          Foreground="White"
          VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <StackPanel
      Grid.Row="1"
      Margin="20,16,20,12">
      <!-- 常用动作直接可见；建标方式和文件操作按目的分组。 -->
      <!-- 操作入口在后台任务期间统一禁用，防止参数和标准被并发修改。 -->
      <WrapPanel
        x:Name="Actions">
        <Button
          x:Name="LoadImageButton"
          Style="{StaticResource ActionButton}"
          Content="加载待测图像"
          Click="LoadImage_Click"
          Background="#087F8C"
          Foreground="White"
          BorderThickness="0" />
        <Button
          x:Name="BuildStandardMenuButton"
          Style="{StaticResource ActionButton}"
          Content="建立标准 ▾"
          Click="OpenActionMenu_Click">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem
                Header="多图采样建标"
                Click="MultiStandard_Click"
                ToolTip="选择同一合格膜片在不同位置的多次拍摄，计算对应圆点的 Lab 均值。" />
              <MenuItem
                Header="单图建标"
                Click="LoadStandard_Click" />
              <Separator />
              <MenuItem
                Header="当前图设为标准"
                Click="UseCurrent_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button
          Style="{StaticResource ActionButton}"
          Content="设置 / 微调标准"
          Click="Settings_Click" />
        <Button
          x:Name="StandardFileMenuButton"
          Style="{StaticResource ActionButton}"
          Content="标准文件 ▾"
          Click="OpenActionMenu_Click">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem
                Header="读取标准"
                Click="ReadStandard_Click" />
              <MenuItem
                Header="保存标准"
                Click="SaveStandard_Click" />
              <Separator />
              <MenuItem
                Header="清除标准并重置"
                ToolTip="清空标准、图像与结果；ROI 和全部检测参数恢复默认。保留磁盘上已保存的标准 JSON。"
                Click="ClearStandard_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button
          Style="{StaticResource ActionButton}"
          Content="批量检测"
          Click="Batch_Click" />
        <Button
          Style="{StaticResource ActionButton}"
          Content="导出报告"
          Click="Export_Click"
          ToolTip="导出离线 HTML 图文报告，或选择 CSV 保存详细数值。" />
      </WrapPanel>
      <TextBlock
        x:Name="ErrorBanner"
        Visibility="Collapsed"
        Foreground="#B3261E"
        TextWrapping="Wrap"
        Margin="0,8" />
      <Grid
        Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="*" />
          <ColumnDefinition
            Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel
          VerticalAlignment="Top">
          <Border
            x:Name="VerdictBadge"
            DockPanel.Dock="Left"
            Background="#DDE6EE"
            CornerRadius="5"
            Padding="13,7"
            Margin="0,0,14,0">
            <TextBlock
              x:Name="Verdict"
              Text="待加载"
              FontSize="14"
              FontWeight="Bold"
              Foreground="#31506B" />
          </Border>
          <TextBlock
            x:Name="Summary"
            Text="建立或读取标准，然后加载待测图像。"
            FontSize="14"
            VerticalAlignment="Center"
            Foreground="#50667C"
            TextWrapping="Wrap" />
        </DockPanel>
        <StackPanel
          Grid.Column="1"
          Margin="18,0,0,0">
          <Button
            x:Name="CancelBatch"
            Content="取消批量"
            Click="CancelBatch_Click"
            Visibility="Collapsed"
            Padding="10,4" />
          <Expander
            Header="显示选项"
            FontSize="14"
            HorizontalAlignment="Right">
            <StackPanel
              Margin="0,8,0,0">
              <CheckBox
                x:Name="SyncViews"
                Content="同步左右视图"
                IsChecked="True"
                Margin="0,4" />
              <CheckBox
                x:Name="MaskToggle"
                Content="显示取色掩膜"
                Checked="Mask_Checked"
                Unchecked="Mask_Checked"
                Margin="0,4" />
              <CheckBox
                x:Name="ContoursToggle"
                Content="显示轮廓 / 内圈"
                IsChecked="True"
                Checked="Overlay_Checked"
                Unchecked="Overlay_Checked"
                Margin="0,4" />
              <Button
                Content="适应窗口"
                Click="Fit_Click"
                Padding="10,4"
                Margin="0,6,0,0" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </StackPanel>
    <Grid
      Grid.Row="2"
      Margin="20,0,20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="12" />
        <ColumnDefinition
          Width="*" />
      </Grid.ColumnDefinitions>
      <Border
        BorderBrush="#D8E1EA"
        BorderThickness="1"
        CornerRadius="5"
        Background="White">
        <DockPanel>
          <StackPanel
            DockPanel.Dock="Top"
            Margin="14,10">
            <TextBlock
              Text="标准 OK"
              FontSize="15"
              FontWeight="SemiBold"
              Foreground="#254A63" />
            <TextBlock
              x:Name="StandardCaption"
              Text="尚未设置标准"
              Foreground="#718195"
              Margin="0,4,0,0"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <local:ImageViewport
            x:Name="StandardView" />
        </DockPanel>
      </Border>
      <Border
        Grid.Column="2"
        BorderBrush="#D8E1EA"
        BorderThickness="1"
        CornerRadius="5"
        Background="White">
        <DockPanel>
          <Grid
            DockPanel.Dock="Top"
            Margin="14,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock
                Text="待测图像"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#254A63" />
              <TextBlock
                x:Name="CurrentCaption"
                Text="可拖入 BMP / PNG / JPEG / TIFF"
                Foreground="#718195"
                Margin="0,4,0,0"
                TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
              Grid.Column="1"
              Orientation="Horizontal">
              <Button
                Content="上一张"
                Click="Previous_Click"
                Padding="10,5" />
              <Button
                Content="下一张"
                Click="Next_Click"
                Padding="10,5" />
            </StackPanel>
          </Grid>
          <local:ImageViewport
            x:Name="CurrentView" />
        </DockPanel>
      </Border>
    </Grid>
    <Border
      Grid.Row="3"
      Margin="20,0,20,12"
      Background="White"
      BorderBrush="#D8E1EA"
      BorderThickness="1"
      CornerRadius="5">
      <DockPanel>
        <DockPanel
          DockPanel.Dock="Top"
          Margin="14,10">
          <CheckBox
            x:Name="DetailsToggle"
            DockPanel.Dock="Right"
            Content="展开 Lab 明细"
            FontSize="14"
            Checked="DetailsToggle_Changed"
            Unchecked="DetailsToggle_Changed"
            VerticalAlignment="Center" />
          <TextBlock
            Text="检测结果"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="#254A63"
            Margin="0,0,22,0" />
          <TextBlock
            x:Name="ColorParameterSummary"
            Text="ΔE00：kL=1 · kC=1 · kH=1"
            Foreground="#718195"
            VerticalAlignment="Center" />
        </DockPanel>
        <Expander
          x:Name="EvidencePanel"
          DockPanel.Dock="Bottom"
          Header="检测依据与配准详情"
          Margin="12,6"
          FontSize="13">
          <ScrollViewer
            MaxHeight="90"
            VerticalScrollBarVisibility="Auto">
            <TextBlock
              x:Name="EvidenceText"
              Text="点击圆点或表格行查看对应区域；展开后显示测量与配准证据。"
              TextWrapping="Wrap"
              Foreground="#315878"
              Margin="6,8" />
          </ScrollViewer>
        </Expander>
        <!-- 结果表消费 Inspection 生成的行；选择只联动视图，不重新判断颜色。 -->
        <DataGrid
          x:Name="ResultsGrid"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionChanged="ResultSelection_Changed"
          FontSize="14"
          RowHeight="30">
          <DataGrid.Columns>
            <DataGridTextColumn
              Header="#"
              Binding="{Binding Id}"
              Width="44" />
            <DataGridTemplateColumn
              Header="颜色"
              Width="65">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border
                    Width="22"
                    Height="22"
                    CornerRadius="11"
                    Background="{Binding Swatch}"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              Header="Mark 名称"
              Binding="{Binding Name}"
              Width="140" />
            <DataGridTextColumn
              Header="对应墨路"
              Binding="{Binding InkChannel}"
              Width="150" />
            <DataGridTextColumn
              Header="ΔE00"
              Binding="{Binding DeltaE}"
              Width="110" />
            <DataGridTextColumn
              Header="阈值"
              Binding="{Binding Threshold}"
              Width="95" />
            <DataGridTemplateColumn
              Header="结果"
              Width="*"
              MinWidth="160">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding Status}"
                    ToolTip="{Binding Reason}"
                    Foreground="{Binding Foreground}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              x:Name="ReferenceLabColumn"
              Header="标准 L* / a* / b*"
              Binding="{Binding ReferenceLab}"
              Width="180"
              Visibility="Collapsed" />
            <DataGridTextColumn
              x:Name="CurrentLabColumn"
              Header="待测 L* / a* / b*"
              Binding="{Binding CurrentLab}"
              Width="180"
              Visibility="Collapsed" />
            <DataGridTextColumn
              x:Name="DeltaLabColumn"
              Header="ΔL* / Δa* / Δb*"
              Binding="{Binding Deltas}"
              Width="190"
              Visibility="Collapsed" />
            <DataGridTextColumn
              x:Name="UniformityColumn"
              Header="σL / σa / σb"
              Binding="{Binding Uniformity}"
              Width="155"
              Visibility="Collapsed" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border
      Grid.Row="4"
      Background="#E7EDF3"
      Padding="20,7">
      <TextBlock
        x:Name="StatusLine"
        Text="滚轮缩放 · 左键拖动 · 双击适应窗口"
        Foreground="#566D82"
        TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
